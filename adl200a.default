# /etc/default/adl200a — configuration for the ADL-200A -> MQTT service.
# Edit ADL200A_PORT to match how the logger is wired, then: systemctl restart adl200a

# Serial port the ADL-200A RS-232 is connected to:
#   Moxa UPort 1150 (USB)  -> /dev/ttyUSB0   (RS-232 mode set automatically)
#   native RS-232 (SoC)    -> /dev/ttyS0, /dev/ttyS1, ...
ADL200A_PORT=/dev/ttyUSB0

ADL200A_BAUD=38400
ADL200A_ID=1
ADL200A_INTERVAL=100
ADL200A_MEA_MAX_SECONDS=90
ADL200A_MEA_IDLE_DONE=20

ADL200A_MQTT_HOST=127.0.0.1
ADL200A_MQTT_PORT=1883
ADL200A_TOPIC=adl200a

# One response waiting for MQTT PUBACK. Deleted after confirmed delivery.
ADL200A_PENDING_FILE=/var/lib/adl200a/pending.json
# Optional stable, unique MQTT client ID (default: adl200a-<hostname>-<logger-id>).
# ADL200A_MQTT_CLIENT_ID=adl200a-uvon-1

# Sensor calibration, one entry per logger channel (see sensors.example.json).
# Without this file the service publishes raw counts only.
ADL200A_SENSORS=/etc/adl200a/sensors.json
